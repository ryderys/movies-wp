# Optional image overrides: PHP_IMAGE, MYSQL_IMAGE, PHPMYADMIN_IMAGE, REDIS_IMAGE

DB_NAME=local_wp
DB_USER=wp_user
DB_PASSWORD=wp_pass
DB_ROOT_PASSWORD=wp_root_pass

WP_DEBUG=1
WP_DEBUG_LOG=1
WP_DEBUG_DISPLAY=0

# Docker mounts only ./wp-content (not the full project) for speed on Windows.
# Edit themes/plugins under wp-content as usual. After changing core/root files, rebuild:
#   docker compose build wordpress && docker compose up -d
#
# Docker: salts are auto-generated in wp-content/.docker-salts.php on first run.
# Or set AUTH_KEY, SECURE_AUTH_KEY, LOGGED_IN_KEY, NONCE_KEY, AUTH_SALT,
# SECURE_AUTH_SALT, LOGGED_IN_SALT, and NONCE_SALT in the environment.

# Signed media delivery (WP mints tokens; media.asiastarx.ir verifies).
# MEDIA_URL_SECRET=   # openssl rand -hex 32 — same value on media server
# MEDIA_BASE_URL=https://media.asiastarx.ir

# MinIO / object storage (prod). Leave empty to disable offload.
# STREAMIT_MINIO_ENDPOINT=https://img.asiastarx.ir
# STREAMIT_MINIO_BUCKET=site-images
# STREAMIT_MINIO_REGION=us-east-1
# STREAMIT_MINIO_KEY=
# STREAMIT_MINIO_SECRET=
# STREAMIT_MINIO_PUBLIC_BASE=https://img.asiastarx.ir/site-images
# STREAMIT_MINIO_REMOVE_LOCAL=1
