# Copy values into the media-server environment or /etc/asiastarx-media.env.php.
# Do not commit real secrets.

MEDIA_ROOT=/data
MOVIE_ROOT=/data/Movie
SERIES_ROOT=/data/series

MEDIA_SCAN_API_KEY=generate-a-long-random-key
MEDIA_SCAN_HMAC_SECRET=generate-a-separate-long-random-secret
MEDIA_SCAN_ALLOWED_IPS=203.0.113.10
MEDIA_SCAN_TIMESTAMP_SKEW=300

# Trailer upload (POST /upload/trailer). Same API key + HMAC secret as scan.
# MEDIA_TRAILER_UPLOAD_MAX_BYTES=134217728
# MEDIA_UPLOAD_NONCE_DIR=/var/tmp/media-upload-nonces
